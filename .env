# music-binder-builder — public configuration
#
# Every parameter the build script reads is listed here with documentation and
# an intentionally-blank default. To override a value, create `.env.local`
# (which is gitignored) and set the keys you care about. `.env.local` wins over
# `.env`. Required parameters must be set in `.env.local` — the script will
# refuse to run otherwise.
#
# See README.md → Setup for details.

# REQUIRED. Absolute path to the folder containing your .doc/.docx chord
# sheets. The folder is searched recursively. Example:
#   CHORD_SHEETS_DIR=/Users/you/Library/CloudStorage/GoogleDrive-…/Chord Sheets
CHORD_SHEETS_DIR=

# REQUIRED. Absolute path to the folder where generated binder PDFs are
# written. Example:
#   OUTPUT_DIR=/Users/you/Downloads
OUTPUT_DIR=

# OPTIONAL. Absolute path to LibreOffice's `soffice` binary. Leave blank to
# autodetect (tries the macOS app bundle, then `which soffice`). Override per
# machine if your install lives somewhere unusual.
#   SOFFICE_PATH=/Applications/LibreOffice.app/Contents/MacOS/soffice
SOFFICE_PATH=

# OPTIONAL. Minimum normalized similarity score (0.0–1.0) for a filename to be
# considered a candidate when fuzzy-matching a song title. Higher = stricter.
# Default 0.75.
FUZZY_MATCH_THRESHOLD=0.75

# OPTIONAL. Planning Center Personal Access Token. Required only if you want
# to build binders from a PCO service plan (the `pco-resolve` and `pco-build`
# subcommands). Both halves are generated together at:
#   https://api.planningcenteronline.com/oauth/applications
# → Personal Access Tokens → New.
PCO_APPLICATION_ID=
PCO_SECRET=

# OPTIONAL. Default PCO Service Type ID to use when --service-type isn’t
# passed. Set this if your org has multiple service types (Sunday Morning,
# Wednesday Evening, etc.) and you almost always pick the same one. Leave
# blank to be prompted on the first ambiguous call.
PCO_DEFAULT_SERVICE_TYPE_ID=
