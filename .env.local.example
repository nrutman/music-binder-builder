# Copy this file to `.env.local` and fill in the values for your machine.
# Anything you set here overrides the (intentionally blank) defaults in `.env`.
# `.env.local` is gitignored.

CHORD_SHEETS_DIR=/Users/you/Library/CloudStorage/GoogleDrive-you@example.com/.shortcut-targets-by-id/…/Chord Sheets
OUTPUT_DIR=/Users/you/Downloads

# Usually leave blank — the script autodetects LibreOffice in the standard
# location. Set this if you installed it somewhere unusual.
# SOFFICE_PATH=/Applications/LibreOffice.app/Contents/MacOS/soffice

# Tune up for stricter matching, down for looser. Default 0.75.
# FUZZY_MATCH_THRESHOLD=0.75

# Planning Center Personal Access Token (only needed for the pco-* commands).
# Generate at https://api.planningcenteronline.com/oauth/applications.
# PCO_APPLICATION_ID=
# PCO_SECRET=

# Default Service Type ID. Only useful if your org has multiple service types.
# PCO_DEFAULT_SERVICE_TYPE_ID=
